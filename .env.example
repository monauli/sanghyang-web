# Supabase — Dashboard > Project Settings > API
# URL dan anon key ini terekspos ke browser (prefix NEXT_PUBLIC_), jadi
# keamanannya bergantung pada RLS policy di database, bukan pada kerahasiaan key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (format sb_secret_..., atau JWT lama role "service_role").
# RAHASIA — JANGAN diberi prefix NEXT_PUBLIC_, jangan dikirim ke browser.
# Melewati RLS sepenuhnya (BYPASSRLS), jadi hanya dipakai satu tempat:
# app/actions/reservation.ts, setelah validasi + anti-spam lolos. Lihat
# web/db/003_reservation_requests_revoke_anon.sql untuk alasannya.
SUPABASE_SERVICE_ROLE_KEY=

# Exely (Fase 4) — hanya dipakai di server (Route Handler / Server Action).
# JANGAN diberi prefix NEXT_PUBLIC_: ini kredensial rahasia.
EXELY_CLIENT_ID=
EXELY_CLIENT_SECRET=
EXELY_PROPERTY_ID=

# URL publik situs (tanpa slash di akhir). Dipakai untuk canonical URL,
# sitemap.xml, dan Open Graph — WhatsApp/Facebook butuh URL absolut.
# Contoh: https://sanghyang.com
NEXT_PUBLIC_SITE_URL=

# Opsional. Kunci HMAC untuk token anti-bot form reservasi. Kalau kosong,
# server memakai kunci acak per proses — cukup untuk satu instance, tapi token
# jadi tidak sah lagi setiap kali server restart atau kalau di-deploy
# multi-instance. Isi dengan string acak panjang kalau perlu.
RESERVATION_FORM_SECRET=

# Panel admin (Fase 6) — menandatangani cookie sesi login /panel-sanghyang.
# RAHASIA — string acak panjang, generate misalnya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
